---
import { link } from '../lib/utils';

interface Props {
  id: string;
  showFullToggle?: boolean;
}

const { id, showFullToggle = false } = Astro.props;
const media = '/media/browser-lookup-2026-11-02';
const excerpt = link(`${media}/excerpt.mp4`);
const full = link(`${media}/full.mp4`);
---

<div class="recording" data-recording data-excerpt={excerpt} data-full={full}>
  <div class="player-shell">
    <video
      id={id}
      aria-label="Codex 查找 Kimi 记录的无声操作样片"
      aria-describedby={`${id}-description`}
      controls
      playsinline
      preload="none"
      poster={link(`${media}/poster.jpg`)}
    >
      <source src={excerpt} type="video/mp4" />
      <p>浏览器无法播放视频，可<a href={full}>下载完整片段</a>。</p>
    </video>
    <button class="play-cover" type="button" aria-label="播放实际操作节选" data-recording-play hidden>
      <span class="play-circle" aria-hidden="true">▶</span>
    </button>
    <span class="mode-label" data-recording-label>00:07 · 静止等待已压缩</span>
  </div>
  <p class="visually-hidden" id={`${id}-description`}>
    无声录屏：在 AI 周报输入 Kimi K3.1 Pro，展开更新详情，查看套餐和上下文条件。
    操作者为当前 Codex 会话，工具依据网页结构定位控件。样片不用于比较模型速度或成功率。
  </p>
  <p class="video-error" data-recording-error role="status" hidden>
    视频暂时无法播放。<a href={full}>下载完整片段</a>，或阅读页面上的操作记录。
  </p>
  {showFullToggle && (
    <div class="recording-actions">
      <button type="button" data-recording-toggle aria-controls={id} hidden>切换完整片段（约 1 分钟）</button>
      <a href={full} download="codex-browser-lookup-2026-11-02.mp4">下载完整片段 ↓</a>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-recording]').forEach((player) => {
    const video = player.querySelector('video');
    const play = player.querySelector<HTMLButtonElement>('[data-recording-play]');
    const toggle = player.querySelector<HTMLButtonElement>('[data-recording-toggle]');
    const label = player.querySelector<HTMLElement>('[data-recording-label]');
    const error = player.querySelector<HTMLElement>('[data-recording-error]');
    if (!video || !play || !label || !error) return;
    let full = false;
    play.hidden = false;
    if (toggle) toggle.hidden = false;

    play.addEventListener('click', async () => {
      error.hidden = true;
      try {
        await video.play();
      } catch {
        error.hidden = false;
      }
    });
    video.addEventListener('play', () => { play.hidden = true; });
    const showError = () => { error.hidden = false; play.hidden = true; };
    video.addEventListener('error', showError);
    video.querySelector('source')?.addEventListener('error', showError);
    toggle?.addEventListener('click', () => {
      full = !full;
      video.pause();
      video.src = full ? player.dataset.full! : player.dataset.excerpt!;
      video.load();
      play.hidden = false;
      play.setAttribute('aria-label', full ? '播放完整操作片段' : '播放实际操作节选');
      error.hidden = true;
      label.textContent = full ? '01:04 · 完整录制时间轴' : '00:07 · 静止等待已压缩';
      toggle.textContent = full ? '切换操作节选（等待已压缩）' : '切换完整片段（约 1 分钟）';
    });
  });
</script>

<style>
  .recording { min-width: 0; }
  .player-shell { position: relative; aspect-ratio: 16 / 9; background: #202221; border: 1px solid #292d2a; overflow: hidden; }
  video { width: 100%; height: 100%; object-fit: contain; display: block; background: #202221; }
  .play-cover { position: absolute; inset: 0; width: 100%; border: 0; display: grid; place-items: center; background: linear-gradient(transparent 35%, #10171370); cursor: pointer; }
  .play-circle { display: grid; place-items: center; width: 51px; height: 51px; border-radius: 50%; padding-left: 3px; background: #f4f3ed; color: #25362c; font-size: 19px; box-shadow: 0 3px 24px #0005; }
  .play-cover:hover .play-circle { background: #e1eadb; }
  .mode-label { position: absolute; top: 10px; right: 10px; padding: 2px 7px; font-size: 11px; line-height: 1.6; color: #f4f3ed; background: #151b16c9; pointer-events: none; }
  .recording-actions { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px 16px; margin-top: 11px; }
  .recording-actions a, .recording-actions button { font: inherit; font-size: 12px; color: var(--editorial-green, var(--accent)); text-decoration: underline; text-underline-offset: 4px; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .video-error { font-size: 12px; color: var(--text-muted); }
  .video-error a { text-decoration: underline; }
  [hidden] { display: none !important; }
</style>
