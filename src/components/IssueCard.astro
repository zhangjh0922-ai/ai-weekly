---
import type { CollectionEntry } from 'astro:content';
import { link, formatDate, isoDate } from '../lib/utils';

interface Props {
  issue: CollectionEntry<'issues'>;
  /** 列表页要给 JS 筛选用的数据属性 */
  filterable?: boolean;
  /** 是否展示 highlights 列表 */
  showHighlights?: boolean;
}

const { issue, filterable = false, showHighlights = true } = Astro.props;
const d = issue.data;
const href = link(`/issues/${issue.id}`);

const haystack = filterable
  ? [d.title, d.summary, ...d.highlights, ...d.tags, `第${d.issue}期`].join(' ').toLowerCase()
  : undefined;
---

<article
  class="issue-card"
  data-issue-card={filterable ? '' : undefined}
  data-tags={filterable ? d.tags.join('|') : undefined}
  data-search={haystack}
>
  <div class="issue-card__index">
    <span>ISSUE / 期数</span>
    <strong>{String(d.issue).padStart(2, '0')}</strong>
    <time datetime={isoDate(d.date)}>{formatDate(d.date)}</time>
  </div>
  <div class="issue-card__content">
  <a href={href}>
    <h2>{d.title}</h2>
  </a>
  <p class="issue-card__range">覆盖 {d.range}{d.draft && ' · 草稿'}</p>
  <p>{d.summary}</p>

  {
    showHighlights && d.highlights.length > 0 && (
      <ul>
        {d.highlights.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }

  {
    d.tags.length > 0 && (
      <div class="tag-row">
        {d.tags.map((t) => (
          <a class="tag" href={link(`/tags/${encodeURIComponent(t)}`)}>
            {t}
          </a>
        ))}
      </div>
    )
  }
  </div>
  <a class="issue-card__arrow" href={href} aria-label={`阅读第 ${d.issue} 期：${d.title}`}><span aria-hidden="true">↗</span></a>
</article>
