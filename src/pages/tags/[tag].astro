---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IssueCard from '../../components/IssueCard.astro';
import { link } from '../../lib/utils';

export const getStaticPaths = (async () => {
  const isProd = import.meta.env.PROD;
  const issues = await getCollection('issues', ({ data }) => !isProd || !data.draft);
  const tags = [...new Set(issues.flatMap((i) => i.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      issues: issues
        .filter((i) => i.data.tags.includes(tag))
        .sort((a, b) => b.data.issue - a.data.issue),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, issues } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`所有带「${tag}」标签的 AI 周报。`} wide>
  <div class="editorial-page">
  <header class="page-header">
    <a class="page-back" href={link('/issues')}>← 全部往期</a>
    <p class="page-kicker">TOPIC INDEX / 按主题阅读</p>
    <div class="page-heading-row"><div><h1>{tag}</h1><p class="lede">收录这一主题下的新闻与观察，按期数倒序排列。</p></div><p class="page-number"><strong>{issues.length}</strong>期相关周报</p></div>
  </header>
  <div class="archive-list">
  {issues.map((issue) => <IssueCard issue={issue} />)}
  </div>
  </div>
</BaseLayout>
