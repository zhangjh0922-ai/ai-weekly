---
import BaseLayout from '../layouts/BaseLayout.astro';
import CapabilityMatrix from '../components/CapabilityMatrix.astro';
import RecordingPlayer from '../components/RecordingPlayer.astro';
import { capabilityGuides } from '../data/capability-guide';
import { browserRecording } from '../data/capabilities';
import { link, formatDate } from '../lib/utils';
---

<BaseLayout title="模型功能图鉴" description="对照不同模型的文字、图片、代码、文件、音视频与操作能力，了解每项功能的用途、运行方式、使用入口与来源。" wide editorial>
  <header class="atlas-header">
    <div><p class="atlas-eyebrow">THE CAPABILITY ATLAS</p><h1>模型功能图鉴</h1><p class="atlas-intro">能做什么，在哪里用，背后怎样运行。</p></div>
    <nav class="atlas-jumps" aria-label="图鉴页内导航"><a href="#comparison-title">对照模型 <span>01</span></a><a href="#functions">了解功能 <span>02</span></a><a href="#recording">看实机录屏 <span>03</span></a></nav>
  </header>
  <CapabilityMatrix />
  <section class="function-library" id="functions" aria-labelledby="functions-title">
    <div class="section-heading"><div><p class="atlas-eyebrow">02 / UNDERSTAND</p><h2 id="functions-title">这些功能，具体能做什么？</h2></div><p>选一个功能，看流程与使用场景。</p></div>
    <nav class="function-index" aria-label="跳转到功能解释">{capabilityGuides.map((cap, i) => <a href={`#${cap.id}`}><span>{String(i + 1).padStart(2, '0')}</span>{cap.label}</a>)}</nav>
    <div class="function-details">
      {capabilityGuides.map((cap, index) => <details id={cap.id} data-function-guide open={index === 0}>
        <summary><span class="function-number">{String(index + 1).padStart(2, '0')}</span><strong>{cap.label}</strong><span class="function-english" lang="en">{cap.english}</span><span class="function-expand" aria-hidden="true">+</span></summary>
        <div class="function-body">
          <div class="function-copy"><h3>{cap.title}</h3><p>{cap.summary}</p><a href={link(`/concepts/${cap.concept}`)}>继续读概念解释 ↗</a></div>
          <div class="function-explanation"><ol class="process" aria-label={`${cap.label}的基本流程`}>{cap.steps.map((step, i) => <li><span>{i + 1}</span>{step}</li>)}</ol><div class="example"><h4>可以用来做什么</h4><p>{cap.example}</p></div><p class="boundary"><strong>看清边界</strong>{cap.boundary}</p></div>
        </div>
        {cap.id === 'browser' && <div class="recording-section" id="recording">
          <div class="recording-copy"><p class="atlas-eyebrow">03 / WATCH</p><h3>一段真实的网页操作</h3><p>{browserRecording.description}</p><dl>{browserRecording.facts.map((fact) => <><dt>{fact.label}</dt><dd>{fact.value}</dd></>)}</dl></div>
          <div><RecordingPlayer id="atlas-recording" showFullToggle /><p class="recorded-date">录制于 {formatDate(browserRecording.recordedAt)} · 实机样片，不作为模型排名</p></div>
          <details class="recording-notes"><summary>样片说明、结果与完整记录</summary>{browserRecording.explanations.map((item) => <p><strong>{item.title}：</strong>{item.text}</p>)}{browserRecording.notes.map((note) => <p>{note}</p>)}</details>
        </div>}
      </details>)}
    </div>
  </section>
  <aside class="atlas-end"><p>想看一个型号何时发布、相比之前改了什么？</p><a href={link('/models')}>到模型时间线 →</a></aside>
</BaseLayout>

<script>
  const guides = [...document.querySelectorAll<HTMLDetailsElement>('[data-function-guide]')];
  function openFromHash() {
    const id = location.hash.slice(1);
    const target = guides.find((item) => item.id === (id === 'recording' ? 'browser' : id));
    if (!target) return;
    guides.forEach((item) => { item.open = item === target; });
    document.getElementById(id)?.scrollIntoView({ block: 'start' });
  }
  guides.forEach((item) => item.addEventListener('toggle', () => {
    if (item.open) guides.forEach((other) => { if (item !== other) other.open = false; });
    else item.querySelectorAll('video').forEach((video) => video.pause());
  }));
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => anchor.addEventListener('click', () => {
    const id = anchor.hash.slice(1);
    const target = guides.find((item) => item.id === (id === 'recording' ? 'browser' : id));
    if (target) guides.forEach((item) => { item.open = item === target; });
  }));
  window.addEventListener('hashchange', openFromHash);
  openFromHash();
</script>

<style>
  .atlas-header { display: flex; justify-content: space-between; align-items: end; gap: 35px; padding: 34px 0 32px; margin-bottom: 28px; border-bottom: 1px solid var(--border); }
  .atlas-eyebrow { font-size: 10px; color: var(--accent); letter-spacing: 1.5px; margin: 0 0 8px; }
  .atlas-header h1 { margin: 0 0 10px; font-size: 34px; line-height: 1.35; font-weight: 600; letter-spacing: -1px; }
  .atlas-intro { color: var(--text-muted); margin: 0; font-size: 14px; }
  .atlas-jumps { display: flex; gap: 25px; padding-bottom: 3px; font-size: 12px; }
  .atlas-jumps a { padding-bottom: 6px; border-bottom: 1px solid var(--border-strong); white-space: nowrap; }
  .atlas-jumps span { font-size: 9px; color: var(--accent); margin-left: 15px; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; }
  .section-heading h2 { font-size: 24px; line-height: 1.5; margin: 0; font-weight: 600; }
  .section-heading > p { margin: 0; font-size: 12px; color: var(--text-muted); }
  .function-index { margin: 23px 0 30px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); border-top: 1px solid var(--border); border-left: 1px solid var(--border); }
  .function-index a { padding: 13px 10px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); font-size: 12px; }
  .function-index a:hover { background: var(--bg-sunken); }
  .function-index span { font-size: 10px; color: var(--text-muted); margin-right: 10px; font-family: var(--font-mono); }
  .function-details > details { border-top: 1px solid var(--border); scroll-margin-top: 25px; }
  .function-details > details:last-child { border-bottom: 1px solid var(--border); }
  .function-details > details > summary { cursor: pointer; display: flex; align-items: center; gap: 18px; padding: 20px 0; list-style: none; }
  .function-details > details > summary::-webkit-details-marker { display: none; }
  .function-number { width: 24px; font-family: var(--font-mono); font-size: 11px; color: var(--accent); }
  .function-details summary strong { font-size: 17px; font-weight: 600; }
  .function-english { font-size: 12px; color: var(--text-muted); }
  .function-expand { margin-left: auto; font-size: 23px; line-height: 1; font-weight: 300; }
  .function-details > details[open] > summary .function-expand { transform: rotate(45deg); }
  .function-body { display: grid; grid-template-columns: 1fr 1.5fr; gap: 55px; padding: 12px 0 30px 42px; }
  .function-copy h3 { margin: 0 0 12px; font-size: 23px; line-height: 1.5; font-weight: 500; }
  .function-copy p { font-size: 14px; line-height: 1.9; color: var(--text-muted); margin: 0 0 20px; }
  .function-copy a { font-size: 12px; color: var(--editorial-green); }
  .process { margin: 0 0 22px; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; list-style: none; }
  .process li { font-size: 12px; border-top: 1px solid var(--border-strong); padding-top: 10px; }
  .process li > span { display: block; color: var(--accent); font-family: var(--font-mono); font-size: 11px; margin-bottom: 5px; }
  .example { padding: 16px 18px; background: #e9ede4; border-left: 2px solid #8b9f84; }
  .example h4 { margin: 0 0 5px; font-size: 12px; font-weight: 600; }
  .example p { margin: 0; font-size: 13px; line-height: 1.9; }
  .boundary { margin: 15px 0 0; font-size: 12px; line-height: 1.9; color: var(--text-muted); }
  .boundary strong { margin-right: 10px; color: var(--text); font-weight: 500; }
  .recording-section { display: grid; grid-template-columns: 1fr 1.5fr; gap: 15px 55px; padding: 28px 0 30px 42px; border-top: 1px solid var(--border); scroll-margin-top: 25px; }
  .recording-copy h3 { margin: 0 0 12px; font-size: 22px; font-weight: 500; }
  .recording-copy > p:not(.atlas-eyebrow) { font-size: 13px; color: var(--text-muted); line-height: 1.9; }
  .recording-copy dl { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 11px 15px; margin-top: 22px; font-size: 11px; }
  .recording-copy dt { color: var(--text-muted); }
  .recording-copy dd { margin: 0; }
  .recorded-date { color: var(--text-muted); font-size: 11px; }
  .recording-notes { grid-column: 1 / -1; font-size: 12px; color: var(--text-muted); }
  .recording-notes summary { cursor: pointer; color: var(--text); }
  .recording-notes p { max-width: 800px; }
  .atlas-end { display: flex; justify-content: space-between; gap: 20px; margin: 35px 0 45px; font-size: 13px; }
  .atlas-end p { margin: 0; color: var(--text-muted); }
  .atlas-end a { color: var(--editorial-green); white-space: nowrap; }
  @media (max-width: 850px) {
    .atlas-header { align-items: start; }
    .atlas-jumps { flex-direction: column; gap: 10px; }
    .function-index { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .function-body, .recording-section { gap: 25px; padding-left: 0; }
  }
  @media (max-width: 600px) {
    .atlas-header { padding-top: 25px; flex-direction: column; gap: 22px; }
    .atlas-header h1 { font-size: 29px; }
    .atlas-jumps { flex-direction: row; gap: 20px; font-size: 11px; }
    .atlas-jumps span { margin-left: 8px; }
    .section-heading { display: block; }
    .section-heading h2 { font-size: 21px; }
    .section-heading > p { margin-top: 8px; }
    .function-index { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .function-index a { font-size: 11px; padding: 12px 8px; }
    .function-index span { margin-right: 6px; }
    .function-details > details > summary { gap: 12px; padding-block: 18px; flex-wrap: wrap; }
    .function-details summary strong { font-size: 15px; }
    .function-english { font-size: 10px; flex: 1; }
    .function-body, .recording-section { grid-template-columns: 1fr; gap: 24px; }
    .function-copy h3 { font-size: 21px; }
    .function-copy p { margin-bottom: 12px; }
    .atlas-end { flex-direction: column; gap: 10px; }
  }
</style>
