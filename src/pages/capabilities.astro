---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecordingPlayer from '../components/RecordingPlayer.astro';
import { browserRecording, computerUse, computerUseExamples } from '../data/capabilities';
import { formatDate, link } from '../lib/utils';
---

<BaseLayout
  title="功能与实录"
  description="从真实网页操作与官方文档，看 AI 功能怎样运行、需要哪些工具与环境。"
  wide
  editorial
>
  <div class="capabilities" data-capabilities>
    <header class="guide-header">
      <div>
        <h1>功能与实录</h1>
        <p>从实际操作，看功能怎样运行、能用在哪里。</p>
      </div>
      <div class="guide-switch" role="tablist" aria-label="功能类型" hidden>
        <button id="browser-tab" type="button" role="tab" aria-selected="true" aria-controls="browser" data-function="browser">网页操作</button>
        <button id="computer-tab" type="button" role="tab" aria-selected="false" aria-controls="computer" tabindex="-1" data-function="computer">电脑操作</button>
      </div>
      <noscript>
        <nav class="fallback-links" aria-label="功能类型">
          <a href={link('/capabilities#browser')}>网页操作</a>
          <a href={link('/capabilities#computer')}>电脑操作</a>
        </nav>
      </noscript>
    </header>

    <section id="browser" aria-labelledby="browser-title" data-function-panel>
      <div class="demo-grid">
        <div class="recording-column">
          <div class="video-label"><b>实际页面录制</b><span>Codex / 网页工具</span></div>
          <RecordingPlayer id="capability-recording" showFullToggle />
        </div>
        <div class="task-copy">
          <p class="kicker">网页操作 / BROWSER USE</p>
          <h2 id="browser-title">
            {browserRecording.title.map((line) => <span>{line}</span>)}
          </h2>
          <p>{browserRecording.description}</p>
          <dl>
            {browserRecording.facts.map((fact) => (
              <>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </>
            ))}
          </dl>
        </div>
      </div>

      <div class="result-row">
        {browserRecording.explanations.map((explanation) => (
          <div>
            <h3>{explanation.title}</h3>
            <p>{explanation.text}</p>
          </div>
        ))}
      </div>

      <details class="guide-note">
        <summary>样片说明与完整记录</summary>
        <p>录制于 <time datetime={browserRecording.recordedAt}>{formatDate(browserRecording.recordedAt)}</time>。</p>
        {browserRecording.notes.map((note) => <p>{note}</p>)}
      </details>
    </section>

    <section id="computer" aria-labelledby="computer-title" data-function-panel>
      <div class="desktop-intro">
        <h2 id="computer-title">电脑操作，需要<br />哪些工具与环境？</h2>
        <div>
          {computerUse.introduction.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <p class="documentation-label" id="documentation-note">
        以下为官方文档确认的模型与入口 · 核查于 <time datetime={computerUse.checkedAt}>{computerUse.checkedAt.replaceAll('-', '.')}</time> · 尚未统一实测
      </p>
      <div class="table-wrap" role="region" aria-label="电脑操作模型与入口，窄屏可横向滚动" tabindex="0">
        <table class="support-table" aria-describedby="documentation-note">
          <thead>
            <tr>
              <th scope="col">模型</th>
              <th scope="col">使用入口</th>
              <th scope="col">运行方式与条件</th>
              <th scope="col">依据</th>
            </tr>
          </thead>
          <tbody>
            {computerUseExamples.map((example) => (
              <tr>
                <th scope="row">
                  <strong>{example.model}</strong>
                  <small>{example.organization}</small>
                </th>
                <td>{example.entryPoints.map((entry) => <span>{entry}</span>)}</td>
                <td>{example.conditions}</td>
                <td><a href={example.source.url} target="_blank" rel="noopener noreferrer" aria-label={`${example.model} ${example.source.label}（新窗口）`}>{example.source.label} <span aria-hidden="true">↗</span></a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="guide-note mini-rule">
        {computerUse.scopeNote}
        {' '}<a class="textlink" href={link('/concepts/computer-use')}>阅读完整概念解释 →</a>
      </p>
    </section>

    <a class="backlink" href={link('/')}>← 回到首页</a>
  </div>
</BaseLayout>

<script>
  const guide = document.querySelector<HTMLElement>('[data-capabilities]');
  if (guide) {
    const tablist = guide.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = Array.from(guide.querySelectorAll<HTMLButtonElement>('[data-function]'));
    const panels = Array.from(guide.querySelectorAll<HTMLElement>('[data-function-panel]'));

    function selectTab(name: string) {
      tabs.forEach((tab) => {
        const selected = tab.dataset.function === name;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.id !== name;
        if (panel.hidden) panel.querySelectorAll('video').forEach((video) => video.pause());
      });
    }

    function restoreFromHash() {
      selectTab(location.hash === '#computer' ? 'computer' : 'browser');
    }

    function activateTab(tab: HTMLButtonElement, moveFocus = false) {
      const name = tab.dataset.function!;
      if (location.hash !== `#${name}`) history.pushState(null, '', `#${name}`);
      selectTab(name);
      if (moveFocus) tab.focus();
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(tab));
      tab.addEventListener('keydown', (event) => {
        let next: number;
        switch (event.key) {
          case 'ArrowLeft': next = (index - 1 + tabs.length) % tabs.length; break;
          case 'ArrowRight': next = (index + 1) % tabs.length; break;
          case 'Home': next = 0; break;
          case 'End': next = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        activateTab(tabs[next], true);
      });
    });

    panels.forEach((panel) => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', `${panel.id}-tab`);
      panel.tabIndex = 0;
    });
    restoreFromHash();
    tablist.hidden = false;
    window.addEventListener('hashchange', restoreFromHash);
    window.addEventListener('popstate', restoreFromHash);
  }
</script>

<style>
  .capabilities { font-size: 15px; line-height: 1.7; }
  .guide-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 25px;
    padding: 30px 0 25px;
    border-bottom: 1px solid var(--border);
  }
  .guide-header h1 { margin: 0 0 7px; font-size: 31px; line-height: 1.35; letter-spacing: -1px; font-weight: 600; }
  .guide-header p { margin: 0; font-size: 14px; color: var(--text-muted); }
  .guide-switch { display: flex; flex: none; gap: 5px; padding: 4px; background: #e8e9e1; }
  .guide-switch button {
    border: 0;
    padding: 8px 17px;
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .guide-switch button[aria-selected='true'] { background: var(--bg); color: var(--text); box-shadow: 0 1px 4px #253c2112; }
  .fallback-links { display: flex; gap: 20px; font-size: 13px; color: var(--editorial-green); }
  .demo-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 35px; padding: 28px 0; }
  .recording-column { min-width: 0; }
  .video-label { display: flex; justify-content: space-between; gap: 16px; margin: 0 0 11px; font-size: 12px; line-height: 1.3; color: var(--text-muted); }
  .video-label b { color: var(--text); font-weight: 600; }
  .kicker { display: flex; align-items: center; gap: 12px; color: var(--accent); font-size: 12px; letter-spacing: 1px; margin: 0 0 22px; }
  .kicker::before { content: ''; width: 6px; height: 6px; background: currentColor; }
  .task-copy h2 { margin: 0 0 16px; font-size: 23px; line-height: 1.5; font-weight: 600; }
  .task-copy h2 span { display: block; }
  .task-copy > p:not(.kicker) { margin: 0 0 20px; font-size: 14px; line-height: 1.8; color: var(--text-muted); }
  .task-copy dl { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 10px 16px; margin: 20px 0; font-size: 12px; }
  .task-copy dt { color: var(--text-muted); }
  .task-copy dd { margin: 0; }
  .result-row { display: grid; grid-template-columns: 1fr 1fr; gap: 25px; padding: 22px 24px; margin: 4px 0 27px; background: #e9ede4; border-top: 1px solid #bdcbb9; }
  .result-row h3 { margin: 0 0 5px; font-size: 14px; font-weight: 600; }
  .result-row p { margin: 0; color: var(--text-muted); font-size: 13px; line-height: 1.8; }
  .guide-note { padding: 0 0 26px; font-size: 12px; line-height: 1.9; color: var(--text-muted); }
  .guide-note summary { width: fit-content; color: var(--text); cursor: pointer; }
  .guide-note p { max-width: 810px; }
  .desktop-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding: 30px 0 25px; }
  .desktop-intro h2 { margin: 0; font-size: 29px; line-height: 1.55; letter-spacing: -0.9px; font-weight: 600; }
  .desktop-intro p { margin: 0 0 12px; font-size: 14px; line-height: 1.9; color: var(--text-muted); }
  .documentation-label { margin: 0 0 14px; font-size: 12px; color: var(--editorial-green); }
  .table-wrap { max-width: 100%; overflow-x: auto; }
  .support-table { width: 100%; border-collapse: collapse; margin: 0 0 28px; font-size: 13px; text-align: left; }
  .support-table thead th { padding: 12px 14px 12px 0; border-top: 1px solid var(--text); border-bottom: 1px solid var(--border); font-size: 11px; color: var(--text-muted); font-weight: 500; }
  .support-table tbody th, .support-table td { padding: 19px 20px 19px 0; border-bottom: 1px solid var(--border); vertical-align: top; font-weight: 400; }
  .support-table strong { display: block; font-size: 15px; font-weight: 600; white-space: nowrap; }
  .support-table small { display: block; margin-top: 3px; font-size: 11px; color: var(--text-muted); }
  .support-table td:last-child { padding-right: 0; }
  .support-table td > span { display: block; }
  .support-table a { color: var(--editorial-green); white-space: nowrap; }
  .support-table thead th:nth-child(1) { width: 23%; }
  .support-table thead th:nth-child(2) { width: 23%; }
  .support-table thead th:nth-child(3) { width: 43%; }
  .textlink { color: var(--editorial-green); text-decoration: underline; text-underline-offset: 4px; }
  .mini-rule { border-top: 1px solid var(--border); padding-top: 17px; }
  .backlink { display: inline-block; margin: 4px 0 27px; font-size: 12px; color: var(--text-muted); }
  a:hover { color: var(--accent); }

  @media (max-width: 950px) {
    .demo-grid { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 27px; }
    .task-copy h2 { font-size: 20px; }
  }
  @media (max-width: 700px) {
    .guide-header { display: block; padding-top: 25px; }
    .guide-header h1 { font-size: 28px; }
    .guide-header p { font-size: 13px; }
    .guide-switch { width: fit-content; margin-top: 20px; }
    .fallback-links { margin-top: 20px; }
    .demo-grid { grid-template-columns: minmax(0, 1fr); gap: 22px; padding: 23px 0; }
    .task-copy h2 { font-size: 23px; }
    .task-copy dl { gap: 9px 16px; }
    .result-row { grid-template-columns: minmax(0, 1fr); gap: 19px; padding: 19px; }
    .desktop-intro { grid-template-columns: minmax(0, 1fr); gap: 18px; padding-top: 25px; }
    .desktop-intro h2 { font-size: 26px; }
    .support-table { min-width: 660px; }
    .table-wrap { margin-bottom: 14px; }
    .backlink { margin-bottom: 23px; }
  }
</style>
