---
import BaseLayout from '../layouts/BaseLayout.astro';
import { link } from '../lib/utils';
---

<BaseLayout title="页面不存在" wide>
  <div class="editorial-page"><section class="error-page">
  <p class="page-kicker">PAGE NOT FOUND / 页面未找到</p>
  <p class="error-number" aria-hidden="true">404</p>
  <h1>这页暂时翻不到。</h1>
  <p class="lede">链接可能有误或已失效，可以回到首页，或查看往期周报。</p>
  <p class="page-links">
    <a href={link('/')}>回首页 ↗</a>
    <a href={link('/issues')}>看往期 ↗</a>
    <a href={link('/models')}>模型时间线 ↗</a>
  </p>
  </section></div>
</BaseLayout>
