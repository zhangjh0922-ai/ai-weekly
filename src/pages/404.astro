---
import BaseLayout from '../layouts/BaseLayout.astro';
import { link } from '../lib/utils';
---

<BaseLayout title="页面不存在">
  <p class="eyebrow">404</p>
  <h1 style="font-size:1.7rem;letter-spacing:-0.02em;margin:0.3rem 0 0.75rem;">找不到这个页面</h1>
  <p class="lede">链接可能有误或已失效，可以回到首页，或查看往期周报。</p>
  <p style="margin-top:1.5rem;display:flex;gap:0.6rem;flex-wrap:wrap;">
    <a class="btn" href={link('/')}>回首页</a>
    <a class="btn" href={link('/issues')}>看往期</a>
    <a class="btn" href={link('/models')}>模型时间线</a>
  </p>
</BaseLayout>
