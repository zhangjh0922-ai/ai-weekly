---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ModelDetail from '../components/ModelDetail.astro';
import { link, daysAgo } from '../lib/utils';

const models = (await getCollection('models')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);

const orgs = [...new Set(models.map((m) => m.data.org))].sort((a, b) => a.localeCompare(b));

// prev 存的是 id，这里查成条目本身，供详情区算版本差异
const byId = new Map(models.map((m) => [m.data.id, m]));

// 按年份分组，方便扫读
const byYear = new Map<string, typeof models>();
for (const m of models) {
  const year = m.data.date.slice(0, 4);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(m);
}
const years = [...byYear.keys()].sort((a, b) => b.localeCompare(a));
---

<BaseLayout
  title="模型时间线"
  description="按发布日期整理模型更新，附主要变化、已收录的规格与来源链接。"
  wide
>
  <div class="editorial-page">
  <header class="page-header">
    <p class="page-kicker">MODEL CHRONICLE / 模型档案</p>
    <div class="page-heading-row">
      <div>
        <h1>模型时间线</h1>
        <p class="lede">沿着时间，看模型怎样变化。记录发布、版本与开放动态，保留主要变化、已收录的规格和原始来源。</p>
      </div>
      <p class="page-number"><strong>{models.length}</strong>条更新记录</p>
    </div>
    <div class="page-links">
      <a href={link('/capabilities')}>对照能力与使用入口：模型功能图鉴 ↗</a>
      <a href={link('/concepts')}>查阅概念指南 ↗</a>
    </div>
  </header>

  <div class="filter-bar" role="search" aria-label="筛选模型记录">
    <label class="filter-field"><span>关键词</span><input type="search" id="q" placeholder="搜索模型名、厂商或说明…" autocomplete="off" /></label>
    <label class="filter-field"><span>发布机构</span><select id="model-org"><option value="">全部机构（{orgs.length}）</option>{orgs.map((o) => <option value={o}>{o}</option>)}</select></label>
    <button class="filter-reset" id="model-reset" type="button" hidden>清空筛选</button>
  </div>
  <div class="filter-status"><p id="model-count" role="status" aria-live="polite">共 {models.length} 条记录</p><p>按日期倒序 · 展开查看详情</p></div>
  <noscript><p class="page-note">以下展示全部记录。启用 JavaScript 后可按关键词和机构筛选。</p></noscript>

  <div id="list">
    {
      years.map((year) => (
        <section data-year-group={year}>
          <div class="timeline-year"><h2 data-year-head={year}>{year}</h2><span data-year-count>{byYear.get(year)!.length} 条记录</span></div>
          <ul class="timeline">
            {byYear.get(year)!.map((m) => (
              <li
                class="tl-item"
                id={m.data.id}
                data-model-row
                data-org={m.data.org}
                data-search={[m.data.name, m.data.org, m.data.note, ...m.data.tags]
                  .join(' ')
                  .normalize('NFKC').toLowerCase()}
                data-recent={daysAgo(m.data.date) <= 30 ? 'true' : 'false'}
              >
                <div class="tl-date">
                  <time datetime={m.data.date}>{m.data.date}</time>
                </div>
                <div class="tl-body">
                  <h3>
                    <a href={m.data.url} rel="noopener noreferrer" target="_blank">
                      {m.data.name}
                    </a>
                    <span class="tl-org">{m.data.org}</span>
                  </h3>
                  <p>{m.data.note}</p>
                  <div class="tag-row">
                    {m.data.tags.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                    {m.data.issue && (
                      <a class="tag" href={link(`/issues`)} title={`第 ${m.data.issue} 期写过`}>
                        第 {m.data.issue} 期
                      </a>
                    )}
                  </div>

                  <ModelDetail model={m} prev={m.data.prev ? (byId.get(m.data.prev) ?? null) : null} />
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <p class="empty-note" id="empty" hidden>没有匹配的模型。</p>
  <p class="page-note">日期对应本站收录的发布或开放事件。规格与使用条件以链接中的官方说明为准。发现遗漏或错误，欢迎<a href={link('/about#纠错与共建')}>反馈与共建</a>。</p>
  </div>
</BaseLayout>

<script>
  const q = document.getElementById('q') as HTMLInputElement | null;
  const org = document.getElementById('model-org') as HTMLSelectElement;
  const rows = [...document.querySelectorAll<HTMLElement>('[data-model-row]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-year-group]')];
  const empty = document.getElementById('empty');
  const count = document.getElementById('model-count')!;
  const reset = document.getElementById('model-reset')!;

  function apply() {
    const terms = (q?.value ?? '').normalize('NFKC').trim().toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;

    for (const row of rows) {
      const okOrg = !org.value || row.dataset.org === org.value;
      const okTerm = terms.every((term) => (row.dataset.search ?? '').includes(term));
      const visible = okOrg && okTerm;

      row.hidden = !visible;
      if (visible) shown++;
    }

    // 一整年都被过滤掉时，把年份标题也藏起来
    for (const group of groups) {
      const visible = [...group.querySelectorAll<HTMLElement>('[data-model-row]')].filter(
        (r) => !r.hidden,
      );
      group.hidden = visible.length === 0;
      group.querySelector('[data-year-count]')!.textContent = `${visible.length} 条记录`;
    }

    if (empty) empty.hidden = shown > 0;
    count.textContent = terms.length || org.value ? `找到 ${shown} 条记录 / 共 ${rows.length} 条` : `共 ${rows.length} 条记录`;
    reset.hidden = !q?.value && !org.value;
  }

  q?.addEventListener('input', apply);

  org.addEventListener('change', apply);
  reset.addEventListener('click', () => {
    if (q) q.value = '';
    org.value = '';
    apply();
    q?.focus();
  });
  apply();
</script>
