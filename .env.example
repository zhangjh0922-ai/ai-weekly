# 复制成 .env 后填写。.env 已在 .gitignore 里，不会被提交。
# 只有 scripts/draft.mjs 需要这些；采集和建站都不需要 API key。

# ---------------------------------------------------------------------------
# 选一个厂商。可选值：
#   anthropic   openai   deepseek   moonshot   zhipu   qwen
#   siliconflow openrouter   gemini   ollama   custom
# ---------------------------------------------------------------------------
LLM_PROVIDER=deepseek

# 模型名。强烈建议显式写 —— 代码里的默认值只是兜底，很可能已经过期。
# 各家的模型列表见 scripts/lib/llm.mjs 里每个 preset 的 models 字段。
LLM_MODEL=deepseek-chat

# 对应厂商的 key 填一个就行。也可以统一用 LLM_API_KEY 覆盖任意厂商。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# LLM_API_KEY=

# 走自建网关 / 代理时用（LLM_PROVIDER=custom 时必填）
# LLM_BASE_URL=https://your-gateway.example.com/v1

# ---------------------------------------------------------------------------
# 部署相关，只在 GitHub Actions 里需要，本地开发不用管
# ---------------------------------------------------------------------------
# SITE_URL=https://your-name.github.io
# BASE_PATH=/ai-weekly/
